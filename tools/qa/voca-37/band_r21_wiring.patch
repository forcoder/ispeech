 def tier_of(screen_w, dpi):
     """-> (档位 1/2, 逻辑宽 dp)。逻辑宽 = 屏宽 px ÷ (density/160)，与 ac10_budget.py 同式。"""
     lw = screen_w * 160.0 / dpi
