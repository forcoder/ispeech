# Gradle / Android build outputs
.gradle/
build/
app/build/
.kotlin/
!gradle/wrapper/gradle-wrapper.jar

# 仓库根目录的临时 APK（正式发布包放 dist/）
/ispeech-*.apk

# 本机 Android SDK 配置（从 local.properties.example 复制）
local.properties

# Native build
.cxx/
.externalNativeBuild/
captures/

# IDE & OS
.idea/
*.iml
.DS_Store

# Test / report artifacts
test-results/
reports/

# 本地产物 / 误提交的旧构建副本
build-voca30/

# 智能体运行时写进工作区根目录的文件（不属于产品代码）
.multica/
.pi/
.qoder/
AGENTS.md

# 临时 worktree / 本地运行时
.claude/worktrees/
.claude/settings.local.json

# dist/ 白名单：只有「已交付」的包入库（dist/README.md、SHA256SUMS、ispeech-*-vN.M.apk）。
# tools/deploy/deploy.sh 产出的是带时间戳的一次性部署包，加上 internal 内测包，体积可远超
# GitHub 单文件 100 MiB 硬上限；一旦落进工作区，智能体运行时的基线提交会把它写进分支历史，
# 该分支就再也推不上去（VOCA-445）。新产物默认不入库，确要交付用 git add -f。
dist/*
!dist/README.md
!dist/SHA256SUMS
!dist/_archive/
dist/_archive/*
!dist/_archive/ispeech-release-v*.apk
!dist/ispeech-release-v*.apk
!dist/ispeech-debug*.apk

# 短语数据导出
通用短语.csv
