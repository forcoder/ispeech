# Gradle / Android build outputs
.gradle/
build/
app/build/
.kotlin/
!gradle/wrapper/gradle-wrapper.jar

# 仓库根目录的临时 APK（正式发布包放 dist/）
/ispeech-*.apk

# 本机 Android SDK 配置（从 local.properties.example 复制）
local.properties

# Native build
.cxx/
.externalNativeBuild/
captures/

# IDE & OS
.idea/
*.iml
.DS_Store

# Test / report artifacts
test-results/
reports/

# 本地产物 / 误提交的旧构建副本
build-voca30/

# 智能体运行时写进工作区根目录的文件（不属于产品代码）
.multica/
.pi/
.dsh/
AGENTS.md
.qoder/

# 临时 worktree / 本地运行时
.claude/worktrees/
.claude/settings.local.json

# dist/ 下的部署产物（release 包、dist/README.md、SHA256SUMS 继续入库）
dist/deploy-*.log
dist/screenshots/
dist/ispeech-debug-*.apk
dist/app-debug.apk
# 带时间戳的出包产物（>100MB，GitHub 拒收；留在本地不入库）
dist/ispeech-release-1.5-2*.apk
dist/emulator-*.log

# Python 校验脚本的字节码缓存
__pycache__/

# 133 MB，超过 GitHub 单文件 100 MB 硬限制，推上去会被 pre-receive 拒（GH001）
dist/ispeech-release-1.5-20261115-1004.apk

# 短语数据导出
通用短语.csv

# 本地构建用的可写 GRADLE_USER_HOME / ANDROID_USER_HOME（智能体沙箱用，不入库）
.gradle-home/
.android-home/
.tmp/

# 带时间戳的临时出包 / 模拟器日志（正式包是 dist/ispeech-release-v<major>.<minor>.apk）
dist/ispeech-release-*-2*.apk
dist/emulator-*.log

# Python 静态检查脚本的字节码缓存（tools/verify 会被反复执行）
__pycache__/
*.pyc
