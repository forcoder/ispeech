<!--
  语音输入键图标：麦克风（胶囊收音头 + 下方弧线支架 + 底座）。
  复刻搜狗 Android 版 `ime_function_voice.png` 的几何形状。
  说明：搜狗语音键在不同版本有「实心麦克风」与「描边麦克风」两种画法，
  这里沿用本项目其它功能键（ic_phrase / ic_settings_gear）统一的描边风格，
  由 [SoftKeyboardView] 按 KeyStyle.ACCENT 自动着色，与整排工具栏图标观感一致。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 收音头：上下圆头的胶囊 -->
    <path
        android:pathData="M9.8,5.4 a2.2,2.2 0 0 1 4.4,0 v5.2 a2.2,2.2 0 0 1 -4.4,0 z"
        android:strokeColor="#1F2329"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <!-- 支架：从左侧绕过底部到右侧的半圆 -->
    <path
        android:pathData="M6.2,11.4 a5.8,5.8 0 0 0 11.6,0"
        android:strokeColor="#1F2329"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <!-- 立柱与底座 -->
    <path
        android:pathData="M12,17.2 v2.6"
        android:strokeColor="#1F2329"
        android:strokeWidth="1.8"
        android:strokeLineCap="round" />
    <path
        android:pathData="M8.8,19.8 h6.4"
        android:strokeColor="#1F2329"
        android:strokeWidth="1.8"
        android:strokeLineCap="round" />
</vector>