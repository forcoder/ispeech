<!--
  「换行」键图标：回车箭头（↵）。

  与 Shift / 工具栏图标一致，用矢量而不是 ↵ 字形：不同 ROM 把 ↵ 画得粗细、大小不一，
  当文字渲染时忽大忽小。路径按 24dp 视野画满（x 4.5→20.5、y 5→17.5），实际渲染 15dp，
  描边 2.4 让箭头在浅蓝键面上仍然清晰；着色由 buildEnterKey 用 imageTintList 统一控制。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M20,5 L20,13 L5,13"
        android:strokeColor="#2E5FD8"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M9.6,9 L5.6,13 L9.6,17"
        android:strokeColor="#2E5FD8"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>