<?xml version="1.0" encoding="utf-8"?>
<!-- 候选条：静态骨架在此声明，候选项由 com.ispeech.input.CandidateView 按查询结果动态创建。
     竖向两行：第 1 行是当前组合码（输入行），第 2 行是候选词 + 翻页器 + 设置入口。 -->
<com.ispeech.input.CandidateView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/candidate_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F2F3F5"
    android:minHeight="44dp"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="4dp"
    android:paddingEnd="6dp"
    android:paddingBottom="4dp">

    <!-- 第一行：组合码（主题色高亮），左对齐 -->
    <TextView
        android:id="@+id/candidate_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:textSize="18sp"
        android:visibility="gone" />

    <!-- 第二行：候选 + 翻页器 + 设置，横向排列 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="38dp"
        android:orientation="horizontal">

        <!-- 候选区：横向滚动，候选项动态添加 -->
        <HorizontalScrollView
            android:id="@+id/candidate_scroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/candidate_items"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- 翻页器：候选多于一页时出现，指示「1/3」并支持上一页 / 下一页 -->
        <LinearLayout
            android:id="@+id/candidate_pager"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <!-- 翻页箭头：复刻搜狗五笔候选条的 oh_pageup_off1 / oh_pagedown_off1 矢量图 -->
            <ImageView
                android:id="@+id/candidate_page_prev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:contentDescription="上一页候选"
                android:focusable="true"
                android:paddingStart="6dp"
                android:paddingTop="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="4dp"
                android:scaleType="center"
                android:src="@drawable/ic_page_prev" />

            <TextView
                android:id="@+id/candidate_page_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:contentDescription="候选页码，点击查看下一页"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="2dp"
                android:paddingTop="4dp"
                android:paddingEnd="2dp"
                android:paddingBottom="4dp"
                android:text="1/1"
                android:textColor="#666666"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/candidate_page_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:contentDescription="下一页候选"
                android:focusable="true"
                android:paddingStart="4dp"
                android:paddingTop="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="4dp"
                android:scaleType="center"
                android:src="@drawable/ic_page_next" />
        </LinearLayout>

        <!-- 设置入口：齿轮矢量图（ic_settings_gear），替代原先的 ⚙ 字符 -->
        <ImageView
            android:id="@+id/candidate_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:contentDescription="设置"
            android:focusable="true"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp"
            android:scaleType="center"
            android:src="@drawable/ic_settings_gear" />
    </LinearLayout>
</com.ispeech.input.CandidateView>