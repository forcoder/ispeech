<?xml version="1.0" encoding="utf-8"?>
<!--
  输入法整体输入视图：上方候选条 + 下方内容区。

  内容区同时容纳：
  - 软键盘面板（默认可见）
  - csBaby 快捷短语面板（点工具栏「短语」时显示）
  - 剪贴板面板（点工具栏「剪贴」时显示）
  - 输入法切换面板（点工具栏「⌨」时显示）
  各面板互斥显示，服务侧切换 visibility；GONE 的子视图不参与测量，
  因此窗口高度始终跟随当前可见面板。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ime_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_gravity="bottom">

    <include
        layout="@layout/candidate_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <FrameLayout
        android:id="@+id/ime_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.ispeech.input.SoftKeyboardView
            android:id="@+id/soft_keyboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.ispeech.input.QuickPhrasePanel
            android:id="@+id/quick_phrase_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <com.ispeech.input.ClipboardPanel
            android:id="@+id/clipboard_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <com.ispeech.input.InputMethodPanel
            android:id="@+id/input_method_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
