<?xml version="1.0" encoding="utf-8"?>
<!-- 候选条：静态骨架在此声明，候选项由 com.ispeech.input.CandidateView 按查询结果动态创建。
     竖向两行：第 1 行是当前组合码（输入行），第 2 行是候选词（横向滑动）。
     候选行不放假翻页箭头 / 页码器 / 设置齿轮：左右拖动即可浏览候选，空间全部留给候选词。 -->
<com.ispeech.input.CandidateView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/candidate_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F2F3F5"
    android:minHeight="44dp"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="4dp"
    android:paddingEnd="6dp"
    android:paddingBottom="4dp">

    <!-- 第一行：组合码（主题色高亮），左对齐 -->
    <TextView
        android:id="@+id/candidate_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:textSize="18sp"
        android:visibility="gone" />

    <!-- 第二行：候选区，横向滚动，候选项动态添加 -->
    <HorizontalScrollView
        android:id="@+id/candidate_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="38dp"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/candidate_items"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="38dp"
            android:orientation="horizontal" />
    </HorizontalScrollView>
</com.ispeech.input.CandidateView>
