<?xml version="1.0" encoding="utf-8"?>
<!-- 候选条：静态骨架在此声明，候选项由 com.ispeech.input.CandidateView 按查询结果动态创建。
     一行横排：组合码 + 候选词（横向滑动）+ 可选的麦克风授权按钮。不放假翻页箭头 / 页码器 / 设置齿轮，
     左右拖动即可浏览候选，横向空间全部留给候选词。 -->
<com.ispeech.input.CandidateView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/candidate_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F4F5F7"
    android:gravity="center_vertical"
    android:minHeight="44dp"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="4dp"
    android:paddingEnd="6dp"
    android:paddingBottom="4dp">

    <!-- 组合码（主题色高亮） -->
    <TextView
        android:id="@+id/candidate_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 候选区（含 AC-12 溢出线索）。线索是叠在滚动区右沿的一层遮罩，不参与横向布局，
         所以不占候选的横向预算（规格 AC-12 实现口径 ①：零宽度成本）。 -->
    <FrameLayout
        android:id="@+id/candidate_scroll_frame"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <!-- 候选区：横向滚动，候选项动态添加 -->
        <HorizontalScrollView
            android:id="@+id/candidate_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="38dp"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/candidate_items"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- AC-12 溢出线索：右沿渐变遮罩，只在「还有候选没进视口」时可见。
             宽度与渐变色在 CandidateView 里按令牌设置（12 dp）。
             height 不能写 match_parent：父 FrameLayout 是 wrap_content，match_parent 的孩子
             在 AT_MOST 下会拿到「整块可用高度」并反过来把父撑满，键盘被顶出屏幕
             （2026-11-24 emulator-5554 实测 IME 窗口被撑到 [0,158][1260,2720]，
             键面白像素 14855→19）。height 由 CandidateView 按滚动区实测高度补齐，
             这里给 0dp 表示不参与父的高度测量。
             importantForAccessibility=no：不新增常驻可聚焦元素，读屏走滚动容器自带的
             ACTION_SCROLL_FORWARD（见 CandidateView.readOverflowState）。 -->
        <View
            android:id="@+id/candidate_overflow_cue"
            android:layout_width="12dp"
            android:layout_height="0dp"
            android:layout_gravity="end"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 麦克风授权入口（VOCA-166）：候选条右侧独立动作按钮，仅未授权提示态可见。
         必须是 candidate_items 之外的兄弟控件——CandidateView.update() 每次刷新只清空候选区，
         放进候选区会随候选消失；做成候选项会被空格 / 数字键上屏语义误触发。
         尺寸与颜色在 com.ispeech.input.CandidateView 里按令牌设置（触摸目标 ≥44dp×64dp）。 -->
    <TextView
        android:id="@+id/candidate_mic_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:minWidth="64dp"
        android:minHeight="44dp"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="14sp"
        android:visibility="gone" />
</com.ispeech.input.CandidateView>
