<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- csBaby 云端同步需要网络 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 语音输入需要录音权限（系统 SpeechRecognizer） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- targetSdk 34 下 SpeechRecognizer 需要声明语音识别服务的包可见性 -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".IspeechApp"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ispeech">

        <!-- 设置主界面 -->
        <!--
          singleTask 是麦克风授权桥的必要条件：输入法以 NEW_TASK 拉起时，若实例已存在，
          标准 launchMode 只会把它带到前台（onNewIntent 都不发），授权框永远弹不出来，
          用户会被丢在设置页里（VOCA-166 AC-4）。
        -->
        <activity
            android:name="com.ispeech.settings.MainActivity"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 输入法服务（BIND_INPUT_METHOD 为系统权限，无需在此声明） -->
        <service
            android:name="com.ispeech.input.IspeechImeService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>
